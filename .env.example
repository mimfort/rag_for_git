# ============================================================================
# rag_for_git — конфигурация
# ----------------------------------------------------------------------------
# Анализ PR выполняют субагенты Claude Code (скилл /rag-reviewer:review-pr),
# поэтому ОТДЕЛЬНЫЙ LLM-ключ здесь НЕ нужен — модель даёт Claude Code.
# Единственный обязательный внешний ключ — VOYAGE_API_KEY (эмбеддинги+реранкер).
# .env gitignored — реальные ключи держим только локально.
# Все переменные ниже имеют дефолты в reviewer/config/settings.py; в .env
# достаточно задать секреты (VOYAGE_API_KEY, GITHUB_TOKEN) и переопределения.
# ============================================================================

# ============================================================================
# Voyage (эмбеддинги + реранкер) — единственный обязательный внешний ключ
# ============================================================================
VOYAGE_API_KEY=
# Модель эмбеддингов.
EMBEDDING_MODEL=voyage-code-3
# Размерность должна совпадать с колонкой vector(N); смена требует реиндекса.
EMBEDDING_DIM=1024
# Текстов в одном запросе эмбеддинга (≤1000 и ≤120K токенов на запрос).
EMBEDDING_BATCH_SIZE=256
# Модель реранкера.
RERANK_MODEL=rerank-2.5

# ============================================================================
# GitHub
# ============================================================================
# PAT с доступом к PR (Pull requests: read/write, Contents: read).
GITHUB_TOKEN=
# Ретраи на сетевые сбои GitHub API.
GITHUB_RETRY_ATTEMPTS=3
# База экспоненциального backoff, сек.
GITHUB_RETRY_BACKOFF_BASE=1.0

# ============================================================================
# multi-platform VCS (PRI-133): тип провайдера определяется автоматически из git
# remote при `reviewer index`; здесь — фолбэк-платформа и токены по платформе.
# ============================================================================
# Фолбэк, если репо не индексирован/remote не распознан.
VCS_PROVIDER=github
# PAT GitLab (api scope) — для ревью GitLab MR.
GITLAB_TOKEN=
# Base URL; для self-hosted выводится из remote автоматически.
GITLAB_URL=https://gitlab.com

# ============================================================================
# Postgres (ParadeDB: pgvector + pg_search) / Neo4j
# ============================================================================
# ParadeDB на хост-порту 5433.
PG_DSN=postgresql://reviewer:reviewer@localhost:5433/reviewer
# Минимум соединений в пуле.
PG_POOL_MIN_SIZE=1
# Максимум соединений в пуле.
PG_POOL_MAX_SIZE=4
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reviewerpass

# ============================================================================
# Только для тестов: изолированные сервисы `docker compose --profile test`
# ----------------------------------------------------------------------------
# Никогда не направляйте TEST_* на dev/production. Production Settings игнорирует
# эти переменные; их читает только тестовая инфраструктура.
# ============================================================================
TEST_PG_DSN=postgresql://reviewer_test:reviewer_test@localhost:55433/reviewer_test?connect_timeout=2
TEST_NEO4J_URI=neo4j://localhost:17687
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=reviewer_test_pass

# ============================================================================
# Граф кода
# ============================================================================
# auto = SCIP если scip-python в PATH, иначе tree-sitter; также scip | treesitter.
GRAPH_BACKEND=auto
# Глубина пути кластера для /summarize-subsystems; override в .review.yml; смена = полный пересбор.
SUMMARY_CLUSTER_DEPTH=2

# ============================================================================
# Мульти-репо (опционально)
# ============================================================================
# owner/name: дефолт для `reviewer index` без --repo и search_codebase; пусто = repo обязателен явно.
DEFAULT_REPO=
# Отслеживаемые ветки для ревью (CSV). Первая — первичная (дефолт для
# `reviewer index --ref`, CLI search, solve-task). PR в ветку вне этого
# списка ревью пропускает. Пусто = main.
REVIEW_BRANCHES=main,master

# ============================================================================
# Настройка ревью (дефолты; per-repo .review.yml из base-ветки может переопределить)
# ============================================================================
# Минимальная важность: low | medium | high | critical (ниже — отбрасывать).
REVIEW_SEVERITY_THRESHOLD=medium
# Отбрасывать findings с уверенностью ниже (0..1); выше = меньше шума.
REVIEW_MIN_CONFIDENCE=0.5
# Максимум inline-комментариев на одно ревью.
REVIEW_MAX_COMMENTS=25
# Кап файлов PR на ревью; остальные — в сводку как пропущенные.
REVIEW_MAX_FILES=50
# CSV вайтлист категорий; пусто = все.
REVIEW_CATEGORIES=
# apply = applyable suggestion-блоки GitHub; text = только текстовые советы.
REVIEW_SUGGESTIONS=apply
# Язык текста публикуемых находок.
REVIEW_OUTPUT_LANGUAGE=ru
# Не ревьюить draft-PR.
REVIEW_SKIP_DRAFTS=true
# Писать историю прогонов в Postgres; fail-soft.
REVIEW_HISTORY=true
# Максимальная длина результата MCP tool-вызова, символов.
MAX_TOOL_RESULT_CHARS=8000

# ============================================================================
# Доска задач (опционально) — ГЛОБАЛЬНЫЙ дефолт деплоя
# ----------------------------------------------------------------------------
# Подключение к доске одинаково для всех репозиториев команды/орга, поэтому
# задаётся ОДИН раз здесь, а не дублируется в .review.yml каждого репо.
# Current generic skills resolve `.review.yml` and perform server-side lifecycle operations.
# Per-repo `task_board` переопределяет env metadata; пустой `task_board:` явно выключает доску.
# Тип доски выбирается из явного registry в .review.yml каждого репо (`task_board.type`), а не здесь;
# TASK_BOARD_TYPE устарел и игнорируется. После setup или rotation запускайте `reviewer check`;
# для project-scoped permissions передайте `--board-project TYPE=PROJECT`. Команда не печатает
# credential values.
# ============================================================================
# Legacy metadata for older clients; current generic skills do not use it.
TASK_BOARD_MCP=
# Регэксп ключа задачи, напр. [A-Z]+-\d+.
TASK_BOARD_KEY_PATTERN=
# Optional non-secret шаблон ссылки на задачу.
TASK_BOARD_URL_TEMPLATE=
# Canonical per-provider credentials — только здесь, в env reviewer-mcp; клиентам
# не утекают. `reviewer init` показывает официальные инструкции, скрывает secrets
# и валидирует подключение; `reviewer check` повторяет безопасную validation. Ротация: сначала
# создать новый credential, сохранить его в secret manager/env, проверить, затем отозвать старый.
#
# YouGile: официальный REST flow https://ru.yougile.com/api-v2:
# login/password → companies → API key. `reviewer init` делает это автоматически,
# password держит только в памяти и не сохраняет. OpenID Connect в коробочной версии — вход
# пользователя, не авторизация REST-интеграции. При allowOnlyOpenId готовый key нужно создать
# через отдельный API-capable account.
# Ключ REST YouGile.
YOUGILE_API_KEY=
# Base URL YouGile; пусто → дефолт https://yougile.com/api-v2.
YOUGILE_API_BASE=
#
# YouTrack: https://www.jetbrains.com/help/youtrack/devportal/authentication-with-permanent-token.html
# Profile → Account Security → New permanent token; выбрать YouTrack service scope.
# Полный permanent token с обязательным префиксом perm:.
YOUTRACK_TOKEN=
# Base URL API, например https://company.youtrack.cloud/api.
YOUTRACK_BASE_URL=
#
# Jira: https://id.atlassian.com/manage-profile/security/api-tokens
# Выбрать Create API token (без scopes). Scoped token требует gateway
# api.atlassian.com/ex/jira/{cloudId} и этой direct-site интеграцией не поддержан.
# Direct Jira Cloud site URL, например https://company.atlassian.net.
JIRA_BASE_URL=
# Email Atlassian account для Basic auth.
JIRA_EMAIL=
# API token без scopes для direct site URL.
JIRA_API_TOKEN=
#
# GitHub Issues: https://github.com/settings/personal-access-tokens/new
# Fine-grained token с правом Issues: Read and write на нужный репозиторий
# (classic token — scope repo). GITHUB_TOKEN ревью PR намеренно НЕ является алиасом:
# доска включается только этим отдельным env.
GITHUB_ISSUES_TOKEN=
# Base URL REST API; пусто → https://api.github.com. Для GHES: https://<host>/api/v3.
GITHUB_ISSUES_API_BASE=
#
# Trello: https://trello.com/apps/admin — Power-Up → вкладка API Key → ссылка Token рядом.
# Оба значения секретны: они уходят в query-строке и вместе дают полный доступ к аккаунту.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# Base URL API; пусто → https://api.trello.com/1.
TRELLO_API_BASE=
#
# Linear: https://linear.app/settings/account/security — Personal API keys.
# Ключ уходит в Authorization БЕЗ префикса Bearer; OAuth не поддержан.
LINEAR_API_KEY=
# Base URL GraphQL API; пусто → https://api.linear.app.
LINEAR_API_BASE=
#
# ClickUp: https://developer.clickup.com/docs/authentication — avatar → Settings → Apps.
# Personal token начинается с pk_ и уходит в Authorization без префикса Bearer.
CLICKUP_API_TOKEN=
# Base URL API; пусто → https://api.clickup.com/api/v2.
CLICKUP_API_BASE=
#
# Asana: https://app.asana.com/0/my-apps — Create new token (personal access token).
ASANA_ACCESS_TOKEN=
# Base URL API; пусто → https://app.asana.com/api/1.0.
ASANA_API_BASE=
#
# Yandex Tracker: https://yandex.ru/support/tracker/ru/api-ref/access
# OAuth-токен (долгоживущий) или IAM-токен Yandex Cloud (живёт до 12 часов).
YANDEX_TRACKER_TOKEN=
# Base URL API; пусто → https://api.tracker.yandex.net/v3.
YANDEX_TRACKER_API_BASE=
# Ровно ОДИН из двух ID организации: 360 (X-Org-ID) или Cloud (X-Cloud-Org-ID).
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_CLOUD_ORG_ID=
# Схема Authorization: пусто → OAuth; Bearer — для IAM-токена Yandex Cloud.
YANDEX_TRACKER_AUTH_SCHEME=
#
# Kaiten: https://developers.kaiten.ru/ — API-ключ создаётся в профиле пользователя.
# Адрес компании обязателен (единого cloud base URL нет); суффикс API дописывается сам.
KAITEN_BASE_URL=
KAITEN_API_TOKEN=
#
# Read-only compatibility: если canonical YouGile fields пусты, runtime ещё читает
# TASK_BOARD_API_KEY / TASK_BOARD_API_BASE. Новые .env их не генерируют; не
# дублируйте secrets в обеих формах.

# ============================================================================
# Веб-админка наблюдаемости (опционально; пусто = доступ без аутентификации)
# ============================================================================
# Basic-auth логин для `reviewer serve`.
WEB_ADMIN_USER=
# Basic-auth пароль.
WEB_ADMIN_PASSWORD=
