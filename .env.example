# ============================================================================
# rag_for_git — конфигурация
# ----------------------------------------------------------------------------
# Анализ PR выполняют субагенты Claude Code (скилл /rag-reviewer:review-pr),
# поэтому ОТДЕЛЬНЫЙ LLM-ключ здесь НЕ нужен — модель даёт Claude Code.
# Единственный обязательный внешний ключ — VOYAGE_API_KEY (эмбеддинги+реранкер).
# .env gitignored — реальные ключи держим только локально.
# Все переменные ниже имеют дефолты в reviewer/config/settings.py; в .env
# достаточно задать секреты (VOYAGE_API_KEY, GITHUB_TOKEN) и переопределения.
# ============================================================================

# ============================================================================
# Voyage (эмбеддинги + реранкер) — единственный обязательный внешний ключ
# ============================================================================
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-3      # модель эмбеддингов
EMBEDDING_DIM=1024                 # размерность; ДОЛЖНА совпадать с колонкой vector(N) (смена = реиндекс)
EMBEDDING_BATCH_SIZE=256           # текстов в одном запросе эмбеддинга (≤1000 и ≤120K токенов на запрос)
RERANK_MODEL=rerank-2.5            # модель реранкера

# ============================================================================
# GitHub
# ============================================================================
GITHUB_TOKEN=                      # PAT с доступом к PR (Pull requests: read/write, Contents: read)
GITHUB_RETRY_ATTEMPTS=3            # ретраи на сетевые сбои GitHub API
GITHUB_RETRY_BACKOFF_BASE=1.0      # база экспоненциального backoff, сек

# ============================================================================
# Postgres (ParadeDB: pgvector + pg_search) / Neo4j
# ============================================================================
PG_DSN=postgresql://reviewer:reviewer@localhost:5433/reviewer   # ParadeDB на хост-порту 5433
PG_POOL_MIN_SIZE=1                 # минимум соединений в пуле
PG_POOL_MAX_SIZE=4                 # максимум соединений в пуле
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reviewerpass

# ============================================================================
# Граф кода
# ============================================================================
GRAPH_BACKEND=auto                 # auto = SCIP если scip-python в PATH, иначе tree-sitter; scip | treesitter

# ============================================================================
# Мульти-репо (опционально)
# ============================================================================
DEFAULT_REPO=                      # owner/name: дефолт для `reviewer index` без --repo и для search_codebase; пусто = repo обязателен явно
# Отслеживаемые ветки для ревью (CSV). Первая — первичная (дефолт для
# `reviewer index --ref`, CLI search, solve-task). PR в ветку вне этого
# списка ревью пропускает. Пусто = main.
REVIEW_BRANCHES=main,master

# ============================================================================
# Настройка ревью (дефолты; per-repo .review.yml из base-ветки может переопределить)
# ============================================================================
REVIEW_SEVERITY_THRESHOLD=medium   # минимальная важность: low | medium | high | critical (ниже — отбрасываем)
REVIEW_MIN_CONFIDENCE=0.5          # отбрасывать findings с уверенностью ниже (0..1); выше = меньше шума
REVIEW_MAX_COMMENTS=25             # максимум inline-комментариев на одно ревью
REVIEW_MAX_FILES=50                # кап файлов PR на ревью; остальные — в сводку как пропущенные
REVIEW_CATEGORIES=                 # CSV вайтлист категорий (correctness,security,performance,style); пусто = все
REVIEW_SUGGESTIONS=apply           # apply = applyable suggestion-блоки GitHub; text = только текстовые советы
REVIEW_OUTPUT_LANGUAGE=ru          # язык текста находок в публикуемом ревью
REVIEW_SKIP_DRAFTS=true            # не ревьюить draft-PR
REVIEW_HISTORY=true                # писать историю прогонов в Postgres (наблюдаемость); fail-soft
MAX_TOOL_RESULT_CHARS=8000         # максимальная длина результата MCP tool-вызова, символов

# ============================================================================
# Доска задач (опционально) — ГЛОБАЛЬНЫЙ дефолт деплоя
# ----------------------------------------------------------------------------
# Подключение к доске одинаково для всех репозиториев команды/орга, поэтому
# задаётся ОДИН раз здесь, а не дублируется в .review.yml каждого репо.
# Используется скилами solve-task/sync-tasks (через MCP-тул get_board_config)
# и review-pr. Per-repo .review.yml `task_board` переопределяет; пустой
# `task_board:` в .review.yml явно выключает доску для конкретного репо.
# Все четыре пусты = доска не настроена.
# ============================================================================
TASK_BOARD_TYPE=                   # yougile | jira | ...
TASK_BOARD_MCP=                    # имя MCP-сервера доски (инструменты mcp__<mcp>__*), напр. yougile
TASK_BOARD_KEY_PATTERN=            # регэксп ключа задачи, напр. [A-Z]+-\d+
TASK_BOARD_URL_TEMPLATE=           # шаблон ссылки на задачу, напр. https://ru.yougile.com/team/<id>/#{code}

# ============================================================================
# Веб-админка наблюдаемости (опционально; пусто = доступ без аутентификации)
# ============================================================================
WEB_ADMIN_USER=                    # basic-auth логин для `reviewer serve` / docker-сервиса web
WEB_ADMIN_PASSWORD=                # basic-auth пароль
