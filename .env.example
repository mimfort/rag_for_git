# ============================================================================
# LLM через OpenRouter
# ============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5     # основная модель (любая на OpenRouter)
OPENROUTER_MODELS_FALLBACK=                        # CSV запасных моделей (по порядку), напр. openai/gpt-5-mini
OPENROUTER_MAX_PRICE_PROMPT=3.0                    # потолок цены за 1M ВХОДНЫХ токенов, USD (жёсткий фильтр провайдеров)
OPENROUTER_MAX_PRICE_COMPLETION=15.0              # потолок цены за 1M ВЫХОДНЫХ токенов, USD
OPENROUTER_PROVIDER_SORT=price                    # выбор провайдера: price | throughput | latency
OPENROUTER_PROVIDER_ORDER=                         # CSV: явный порядок провайдеров (опц.)
OPENROUTER_PROVIDER_ONLY=                          # CSV: только эти провайдеры (опц.)
OPENROUTER_PROVIDER_IGNORE=                        # CSV: исключить провайдеров (опц.)
OPENROUTER_ALLOW_FALLBACKS=true                   # разрешить запасных провайдеров
OPENROUTER_REQUIRE_PARAMETERS=true                # только провайдеры с поддержкой наших параметров (tools)
OPENROUTER_DATA_COLLECTION=deny                   # allow | deny — приватность кода
OPENROUTER_APP_URL=https://github.com/mimfort/rag_for_git   # -> заголовок HTTP-Referer (опц.)
OPENROUTER_APP_TITLE=rag_for_git-reviewer                    # -> заголовок X-Title (опц.)

# ============================================================================
# Настройка ревью (дефолты; per-repo .review.yml может переопределить)
# ============================================================================
REVIEW_MAX_TOOL_ITERATIONS=40     # потолок tool-вызовов агента на один файл (защита от дорогого цикла)
REVIEW_SEVERITY_THRESHOLD=medium  # минимальная важность: low | medium | high | critical (ниже — отбрасываем)
REVIEW_MIN_CONFIDENCE=0.5         # отбрасывать findings с уверенностью ниже (0..1); выше = меньше шума
REVIEW_MAX_COMMENTS=25            # максимум inline-комментариев на одно ревью
REVIEW_CATEGORIES=                # CSV вайтлист категорий (correctness,security,performance,style); пусто = все

# ============================================================================
# Voyage (эмбеддинги + реранкер)
# ============================================================================
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-3     # модель эмбеддингов
EMBEDDING_DIM=1024               # размерность; ДОЛЖНА совпадать с колонкой vector(N) (смена = реиндекс)
EMBEDDING_BATCH_SIZE=256         # текстов в одном запросе эмбеддинга (≤1000 и ≤120K токенов на запрос)
RERANK_MODEL=rerank-2.5          # модель реранкера

# ============================================================================
# Postgres (ParadeDB: pgvector + pg_search) / Neo4j
# ============================================================================
PG_DSN=postgresql://reviewer:reviewer@localhost:5433/reviewer   # ParadeDB на хост-порту 5433
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reviewerpass

# ============================================================================
# GitHub
# ============================================================================
GITHUB_TOKEN=                    # PAT с доступом к PR (Pull requests: read/write, Contents: read)
