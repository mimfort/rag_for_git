{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__reviewer__publish_review|mcp__plugin_rag-reviewer_reviewer__publish_review",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${CLAUDE_PLUGIN_ROOT}\"; [ -f \"$root/hooks/review_cost.py\" ] || root=\"$root/plugin\"; exec python3 \"$root/hooks/review_cost.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${CLAUDE_PLUGIN_ROOT}\"; [ -f \"$root/hooks/brief_post_write.py\" ] || root=\"$root/plugin\"; exec python3 \"$root/hooks/brief_post_write.py\""
          }
        ]
      },
      {
        "matcher": "mcp__reviewer__.*|mcp__plugin_rag-reviewer_reviewer__.*",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${CLAUDE_PLUGIN_ROOT}\"; [ -f \"$root/hooks/reviewer_defect.py\" ] || root=\"$root/plugin\"; exec python3 \"$root/hooks/reviewer_defect.py\""
          }
        ]
      }
    ]
  }
}
